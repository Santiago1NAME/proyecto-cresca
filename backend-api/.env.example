MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# JWT_SECRET: Mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

PORT=3000

# CORS_ORIGIN: Debe incluir protocolo (https:// en producción con nginx)
# Desarrollo local: http://localhost:3001 (sin nginx) o https://localhost (con nginx)
# Producción: https://tu-dominio.com
CORS_ORIGIN=https://localhost